-- ============================================================
-- TOGGLE HELPER
-- ============================================================
local function createToggle(name, yPosition, callback)
    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(0, 220, 0, 35)
    toggleBtn.Position = UDim2.new(0.5, -110, 0, yPosition)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
    toggleBtn.BorderSizePixel = 0
    toggleBtn.Text = name .. " [OFF]"
    toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleBtn.TextSize = 14
    toggleBtn.Font = Enum.Font.Gotham
    toggleBtn.Parent = content

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = toggleBtn

    local isOn = false
    toggleBtn.MouseButton1Click:Connect(function()
        isOn = not isOn
        toggleBtn.Text = name .. (isOn and " [ON]" or " [OFF]")
        toggleBtn.BackgroundColor3 = isOn and Color3.fromRGB(0, 120, 60) or Color3.fromRGB(60, 60, 75)
        callback(isOn)
    end)
end

